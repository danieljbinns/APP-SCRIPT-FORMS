    },
    "updateWorkflow": {
      "file": "WorkflowManager.js",
      "purpose": "sets status and current step; mirrors status to the origin sheet"
    },
    "getWorkflow": {
      "file": "WorkflowManager.js",
      "purpose": "reads one workflow row"
    },
    "logFormEdit": {
      "file": "WorkflowManager.js",
