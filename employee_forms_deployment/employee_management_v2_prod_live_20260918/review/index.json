    "sendChangeNotifications": {
      "file": "ChangeNotify.js",
      "purpose": "notifies downstream teams when a submitted form's values change"
    },
    "triggerNextStepFromIDSetup": {
      "file": "IDSetup.js",
      "purpose": "routes from ID Setup to the correct next step"
    },
    "triggerSpecialists": {
      "file": "ITSetupHandler.js",
      "purpose": "fans out the conditional specialist tasks after IT Setup"
