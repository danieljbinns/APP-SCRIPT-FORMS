  "automation": {
    "$comment": "n8n integration. New addition, being enabled across flows. Largely outside the current review scope, though review findings may inform it.",
    "entryPoints": [
      {
        "key": "AUTO_DOPOST",
        "path": "Router.doPost",
        "auth": "PORTAL_SHARED_SECRET in request body",
        "actions": [
          "completeJrTitle"
        ]
      },
      {
        "key": "AUTO_EXEC_API",
        "path": "n8n_* aliases in N8n.js",
        "auth": "Execution API, access ANYONE",
        "actions": [
          "createWorkflow",
          "submitForm",
          "task list/close/draft",
          "ping"
        ]
      }
    ],
    "supportingFiles": [
      "N8n.js",
      "N8nEnvelope.js",
      "EfxApi.js",
      "EfxUtil.js",
      "FormContracts.js",
      "Actor.js",
      "EmployeeIdRegistry.js",
      "RawLog.js"
    ],
    "killSwitch": [
      "EFX_ALIASES_ON",
      "EFX_ALIASES_OFF"
    ]
  },
