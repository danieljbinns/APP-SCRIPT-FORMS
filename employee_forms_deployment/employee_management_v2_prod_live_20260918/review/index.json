      "blocking": false,
      "note": "explicitly excluded from the completion check"
    },
    "TASK_MANAGER": {
      "category": "Manager",
      "group": "ACTOR_MANAGER",
      "formTypes": [],
      "blocking": false,
      "note": "explicitly excluded from the completion check"
    },
    "TASK_ASSETS": {
      "category": "Assets",
      "group": "ACTOR_REQUESTER",
      "formTypes": [],
      "blocking": true
    },
    "TASK_DEACTIVATION": {
      "category": "Deactivation",
      "group": "GRP_IDSETUP",
      "formTypes": [],
      "blocking": true
    },
    "TASK_EOE": {
      "category": "EOE",
      "group": "GRP_HR",
      "formTypes": [],
      "blocking": true
    }
  },
  "completionRules": {
    "checkedBy": "ActionItemService.checkWorkflowCompletion",
    "runsOnlyAtSteps": [
      "Specialist Forms Needed",
      "Action Items Pending"
    ],
    "neverBlocking": [
      "WIS",
      "Manager"
    ],
    "WF_NEW_HIRE": {
      "filter": "ActionItemService.getRequiredSpecialistCats",
      "blockingCategories": [
        "Safety (always)",
        "Purchasing (if Jonas job numbers)",
        "Finance (if any credit card)",
        "Fleet (if Fleetio)",
        "Business Cards (if requested)",
        "30/60/90 Review (if plan306090 = Yes)"
      ],
      "note": "categories not in that set are created but do not hold completion"
    },
    "WF_EQUIPMENT": {
      "filter": null,
      "blockingCategories": [
        "all open items except WIS and Manager"
      ]
    },
    "WF_TERMINATION": {
      "filter": null,
      "blockingCategories": [
        "all open items except WIS and Manager"
      ]
    },
    "WF_POSITION_CHANGE": {
      "filter": null,
      "blockingCategories": [
        "all open items except WIS and Manager"
      ]
    },
    "onComplete": [
      "updateWorkflow(status=Complete)",
      "syncWorkflowState",
      "notifyWorkflowClosure"
    ]
  },
  "postCloseHooks": {
    "$comment": "Behaviour triggered by closing a specific action item, in ActionItemService.closeActionItem.",
    "HOOK_CHANGE_IT_SETUP": {
      "trigger": "category=IT, formType=it_setup, workflow starts CHANGE_",
      "effect": "writes the submitted form data to IT Results so closure email has full context"
    },
    "HOOK_EQUIP_WIS_USER": {
      "trigger": "category=ID Setup, formType=wis_user, workflow starts EQUIP_REQ_",
      "effect": "writes SiteDocs credentials to ID Setup Results"
    },
    "HOOK_CHANGE_WIS_SEQUENCE": {
      "trigger": "formType=boss_wis_update, workflow starts CHANGE_",
      "effect": "calls launchWisAssignment() to create the manager's WIS task — enforces ID Setup before manager assignment"
    }
  },
