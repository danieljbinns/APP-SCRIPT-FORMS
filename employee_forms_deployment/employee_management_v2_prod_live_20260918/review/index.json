  "model": {
    "$comment": "How the pieces relate. A WORKFLOW is the unit of review. A FORM is a reusable step component that may appear in any number of workflows. A STEP INSTANCE is one use of a form inside one workflow, and is what the workflow docs walk through.",
    "workflow": "WF_* — one end-to-end flow. Reviewed individually, even where it shares forms with another flow.",
    "form": "FORM_* — a form as a user meets it. Defined once; used as a step by one or more workflows.",
    "stepInstance": "SI_<WORKFLOW>_<ordinal>_<SLUG> — one form used at one point in one workflow, with its own entry condition, actor and effects. The same FORM in two workflows is two step instances.",
    "field": "FIELD_<TEMPLATE>_<control> — defined once per template; see review/fields/."
  },
