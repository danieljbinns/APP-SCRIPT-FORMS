    },
    "syncWorkflowState": {
      "file": "StateSync.js",
      "purpose": "recomputes the Dashboard_View row for one workflow"
    },
    "getWorkflowContext": {
      "file": "RequestDetailsHandler.js",
      "purpose": "assembles the full cross-sheet context used by emails and forms"
    },
    "sendFormEmail": {
      "file": "EmailUtils.js",
