    {
      "parameters": {
        "jsCode": "// Build one alert item from either the IF false-branch (assertion) or the Execute Workflow error output (transport/script).\nconst j = $input.first().json;\nconst expected = { env: '<<EXPECTED_ENV>>', spreadsheetId: '<<EXPECTED_SHEET_ID>>' };\nlet reason, detail;\nif (j.error) {\n  reason = 'Router call failed';\n  detail = String((j.error && j.error.message) || j.error);\n} else {\n  const problems = [];\n  if (j.ok !== true) problems.push('ok=' + JSON.stringify(j.ok));\n  if (j.env !== expected.env) problems.push('env=' + JSON.stringify(j.env) + ' (expected ' + expected.env + ')');\n  if (j.spreadsheetId !== expected.spreadsheetId) problems.push('spreadsheetId=' + JSON.stringify(j.spreadsheetId) + ' (expected ' + expected.spreadsheetId + ')');\n  reason = 'Ping assertion failed';\n  detail = problems.join('; ') || 'unknown';\n}\nreturn [{ json: {\n  subject: '[EFX canary] ' + reason + ' — ' + expected.env,\n  html: '<p><strong>' + reason + '</strong></p><pre>' + detail.replace(/</g, '&lt;') + '</pre>'\n      + '<p>apiVersion: ' + (j.apiVersion || 'n/a') + ' · libraryVersion: ' + (j.libraryVersion || 'n/a') + ' · callerSession: ' + (j.callerSession || 'n/a') + ' · requestId: ' + (j.requestId || 'n/a') + '</p>'\n      + '<p>Workflow: ' + $workflow.name + ' · execution ' + $execution.id + ' · ' + new Date().toISOString() + '</p>'\n      + '<p>Checks: SA credential/DWD, script still linked to the SA GCP project, API-executable deployment present, Script Properties (SPREADSHEET_ID) unchanged, n8n Router placeholders.</p>'\n} }];"
      },
      "id": "build-alert",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
