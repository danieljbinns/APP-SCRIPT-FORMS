 // ─────────────────────────────────────────────────────────────────────────────
+// updatePreferredName  (EFX 2026-09-17 — post-submit edit, mirrors updateHireDate)
+//
+// Sets or replaces "Preferred Name" (SCHEMA.INITIAL_REQUESTS.PREFERRED_NAME, col 14) on an already-submitted
+// Initial Requests row — HR sometimes learns the preferred name after the New Hire request went in.
+//   Auth:   HR / IT / Admin by the REAL session principal (Actor.principal()), same gate as updateHireDate.
+//   Writes: Initial Requests col 14 only; Form Edit Log (before/after diff, Changed By = Actor.email());
+//           Audit Log 'UPDATE_PREFERRED_NAME'; Raw Log event kind 'request.updated' (source 'updatePreferredName').
+//   Never:  emails, step/status change, Dashboard_View sync (the view has no Preferred Name column), other columns.
+//   Idempotent: same value → { success:true, changed:false } and nothing is written.
+//   Refuses:  empty value, a value starting with = + - @ (validateRequiredFields' formula rule), a Cancelled workflow,
+//             a workflowId that has no Initial Requests row (TERM_/CHANGE_ live in other sheets → "not found").
+// Readers pick the new value up automatically: getWorkflowContext (emails: "First (Preferred) Last"),
+// getIDSetupRequestData, getRequestDetails().requestData.preferredName, RequestHeader.html, IT Confirmation prefill.
+// ─────────────────────────────────────────────────────────────────────────────
+
+var PREFERRED_NAME_MAX_LEN = 100;
+
+function updatePreferredName(workflowId, preferredName) {
+  var newName = (preferredName === undefined || preferredName === null) ? '' : String(preferredName).trim();
+  try {
+    var userEmail = Actor.principal(); // authorization (EFX)
+    var roles = AccessControlService.getUserRolePayload(userEmail);
+    if (!(roles.isAdmin || roles.isHR || roles.isIT)) {
+      return { success: false, message: 'Permission denied. Only HR, IT, or Admin can edit the preferred name.' };
+    }
+
+    if (!workflowId) return { success: false, message: 'workflowId is required.' };
+    if (!newName)    return { success: false, message: 'preferredName is required (non-empty).' };
+    if (['=', '+', '-', '@'].indexOf(newName.charAt(0)) !== -1) {
+      return { success: false, message: 'Preferred name cannot start with =, +, - or @.' };   // same rule as validateRequiredFields
+    }
+    if (newName.length > PREFERRED_NAME_MAX_LEN) {
+      return { success: false, message: 'Preferred name is too long (max ' + PREFERRED_NAME_MAX_LEN + ' characters).' };
+    }
+
+    var wf = getWorkflow(workflowId);
+    if (wf && String(wf['Status'] || '') === 'Cancelled') {
+      return { success: false, message: 'Workflow ' + workflowId + ' is Cancelled — preferred name not changed.' };
+    }
+
+    var ss    = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
+    var sheet = ss.getSheetByName(CONFIG.SHEETS.INITIAL_REQUESTS);
+    if (!sheet) return { success: false, message: 'Initial Requests sheet not found.' };
+
+    var data    = sheet.getDataRange().getValues();
+    var headers = data[0];
+    var wfIdCol = headers.indexOf('Workflow ID');
+    var prefCol = headers.indexOf('Preferred Name');
+    if (wfIdCol === -1 || prefCol === -1) return { success: false, message: 'Required columns not found.' };
+
+    for (var i = 1; i < data.length; i++) {
+      if (String(data[i][wfIdCol]) !== String(workflowId)) continue;
+
+      var oldName = String(data[i][prefCol] || '');
+      if (oldName === newName) {
+        return { success: true, changed: false, workflowId: String(workflowId), preferredName: newName, previousPreferredName: oldName,
+                 message: 'Preferred name is already "' + newName + '" — nothing changed.' };
+      }
+
+      sheet.getRange(i + 1, prefCol + 1).setValue(newName);
+      SpreadsheetApp.flush();
+
+      var newRow = data[i].slice(); newRow[prefCol] = newName;
+      logFormEdit(String(workflowId), 'Initial Request', Actor.email(), data[i], newRow);   // same trail as HR Verification / IT Setup edits
+
+      var detail = '"' + oldName + '" → "' + newName + '"' + (Actor.isAutomation() ? ' (by ' + Actor.label() + ')' : '');
+      writeAuditLog(userEmail, 'UPDATE_PREFERRED_NAME', String(workflowId), detail, 'success');
+      try {
+        if (typeof rawLogEvent_ === 'function') {
+          rawLogEvent_('request.updated', 'updatePreferredName', String(workflowId), { field: 'preferredName', previous: oldName, value: newName });
+        }
+      } catch (evErr) { Logger.log('[updatePreferredName] Raw Log event failed (non-fatal): ' + evErr.message); }
+
+      return { success: true, changed: true, workflowId: String(workflowId), preferredName: newName, previousPreferredName: oldName,
+               message: 'Preferred name updated from "' + oldName + '" to "' + newName + '".' };
+    }
+    return { success: false, message: 'Workflow not found in Initial Requests.' };
+  } catch (e) {
+    Logger.log('[updatePreferredName] Error: ' + e.toString());
+    writeAuditLog(Actor.email(), 'UPDATE_PREFERRED_NAME', workflowId, newName, 'error: ' + e.message);
+    return { success: false, message: e.message };
+  }
+}
