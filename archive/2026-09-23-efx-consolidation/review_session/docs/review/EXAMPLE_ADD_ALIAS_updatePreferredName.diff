-md += `\n### Signatures\n\n\`\`\`\n// reads\nn8n_ping()  ·  n8n_info()  ·  n8n_contracts()\nn8n_getWorkflow(actor, workflowId)\nn8n_getContext(actor, workflowId)                     // full email context, credentials redacted\nn8n_getEmployeeId(actor, workflowId)\nn8n_listWorkflows(actor, { type?, status?, step?, since?, employeeName?, limit?, offset? })\nn8n_listTasks(actor, { workflowId?, taskId?, formType?, status?, assignedTo? })\nn8n_events(actor, { afterEventId?, afterTs?, kinds?, sources?, limit? })\n\n// create (workflow-creating forms)   options = ['record'] | { include:[…], allowUnverified:false }\nn8n_createWorkflow(actor, form, data, options?)       // generic: new_hire | equipment_request | termination_request | position_change_request\nn8n_createInitialRequest(actor, data, options?)       // → { workflowId, formId, internalEmployeeId }\nn8n_createEquipmentRequest(actor, data, options?)\nn8n_createTerminationRequest(actor, data, options?)\nn8n_createPositionChangeRequest(actor, data, options?)\n\n// step submits\nn8n_submitForm(actor, form, data, options?)           // generic: id_setup | hr_verification | it_setup | termination_approval | position_change_approval\nn8n_submitIdSetup(actor, data, options?)              // internalEmployeeId optional (pre-assigned)\nn8n_submitHrVerification(actor, data, options?)       // principal must be HR/Admin\nn8n_submitItSetup(actor, data, options?)              // principal must be IT/Admin\nn8n_submitTerminationApproval(actor, { workflowId, decision, notes? })\nn8n_submitPositionChangeApproval(actor, { workflowId, decision, notes?, confirmedTitle?, confirmedNewManager?, confirmedJrTitle? })\n\n// tasks\nn8n_closeTask(actor, { taskId } | { workflowId, formType }, + notes?, checklist?, formData?, dryRun? )\nn8n_closeJrTask(actor, idOrWorkflow, notes?)          // TK-… or NEW_EMP_…; enforces formType jr_title\nn8n_assignSafetyTraining(actor, workflowId, { siteDocsConfirmed, dssConfirmed, notes?, force?, dryRun? })\nn8n_saveTaskDraft(actor, taskId, notes, { '<item>': { status, comments? } })\n\n// workflow actions (authorization = real session principal: HR/IT/Admin/requester/manager)\nn8n_cancelWorkflow(actor, workflowId)\nn8n_bumpWorkflow(actor, workflowId, targetStep?)\nn8n_updateHireDate(actor, workflowId, 'yyyy-MM-dd')\n\nactor = { id:'n8n:<workflow-slug>', email:'efx-bot@team-group.com', display:'<workflow> (n8n)' }   // attribution only\n\`\`\`\n\n`;
