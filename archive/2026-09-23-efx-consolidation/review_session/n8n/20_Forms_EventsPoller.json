      "parameters": {
        "jsCode": "// Cursor lives in workflow static data (production executions only — manual test runs do not persist it).\nconst sd = $getWorkflowStaticData('global');\nconst params = { limit: 200 };\nif (sd.afterEventId) params.afterEventId = sd.afterEventId;\nelse params.afterTs = sd.afterTs || new Date(Date.now() - 24 * 3600 * 1000).toISOString();   // first run / after prune: last 24 h\nreturn [{ json: { params, cursor: { afterEventId: sd.afterEventId || null, afterTs: params.afterTs || null } } }];"
      },
