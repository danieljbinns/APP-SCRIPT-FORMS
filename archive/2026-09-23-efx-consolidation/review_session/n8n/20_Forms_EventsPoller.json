    {
      "parameters": {
        "jsCode": "// Router output (flattened n8n_events result): { ok, events[], nextAfterEventId, pruned, requestId, ... }\nconst sd = $getWorkflowStaticData('global');\nconst r = $input.first().json;\n\nif (r.pruned === true) {\n  // The cursor eventId is no longer in the Raw Log (RAW_LOG_MAX_ROWS pruning) → resync by time: afterTs = now - 1 day.\n  sd.afterEventId = null;\n  sd.afterTs = new Date(Date.now() - 24 * 3600 * 1000).toISOString();\n  sd.lastPruneResetAt = new Date().toISOString();\n  return [];   // next tick re-reads from afterTs; the seen-set below suppresses duplicates\n}\n\nconst events = Array.isArray(r.events) ? r.events : [];\nsd.seen = Array.isArray(sd.seen) ? sd.seen : [];\nconst seen = new Set(sd.seen);\nconst fresh = events.filter(e => e && e.eventId && !seen.has(e.eventId));\n\nif (r.nextAfterEventId) { sd.afterEventId = r.nextAfterEventId; sd.afterTs = null; }\nelse if (!sd.afterEventId) { sd.afterTs = new Date(Date.now() - 10 * 60 * 1000).toISOString(); }   // nothing yet: keep a 10-min time window moving\n\nfor (const e of fresh) sd.seen.push(e.eventId);\nif (sd.seen.length > 1000) sd.seen = sd.seen.slice(-1000);\nsd.lastPollAt = new Date().toISOString();\nsd.lastBatch = fresh.length;\n\nreturn fresh.map(e => ({ json: {\n  eventId: e.eventId, ts: e.ts, kind: e.kind, source: e.source, workflowId: e.workflowId || '', actor: e.actor || '',\n  payload: e.payload,\n  // convenience for George's flows (present on kind:'result' events)\n  internalEmployeeId: (e.payload && e.payload.internalEmployeeId) || null,\n  formId: (e.payload && e.payload.formId) || null\n} }));"
      },
